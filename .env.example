# ============================================================================
# Sakshya — Environment Configuration Example
# AICTE Security Deposit & FDR Management Portal (PS 1)
# ============================================================================

NEXT_PUBLIC_APP_NAME="Sakshya"
NEXT_PUBLIC_APP_SUBTITLE="AICTE Security Deposit & FDR Management Portal"
NEXT_PUBLIC_ENVIRONMENT_NOTICE="Production / Verification Environment · AICTE Security Deposit & FDR Portal"

# ----------------------------------------------------------------------------
# Supabase PostgreSQL & Storage Configuration (Required for live DB & Storage)
# ----------------------------------------------------------------------------
# 1. Obtain from your Supabase Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# 2. Server-Only Secret (NEVER expose to browser/client code):
# Required only for privileged server operations (migrations, system seeds, storage admin)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# ----------------------------------------------------------------------------
# Storage Configuration
# ----------------------------------------------------------------------------
# Private bucket name created in database migrations
NEXT_PUBLIC_STORAGE_BUCKET="fdr-documents"
